<Window x:Class="CAD_Manager.UI.LineGraphicsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Line Graphics"
        Width="430"
        Height="520"
        MinWidth="390"
        MinHeight="480"
        AllowsTransparency="False"
        Background="{DynamicResource SurfaceBrush}"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Style="{DynamicResource CadWindowStyle}"
        KeyboardNavigation.TabNavigation="Cycle"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterOwner">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      CornerRadius="0"
                      GlassFrameThickness="0,0,0,1"
                      NonClientFrameEdges="None"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid Background="{DynamicResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarMaterialBrush}"
                BorderBrush="{DynamicResource TitleBarBorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        AutomationProperties.Name="Close Line Graphics"
                        Click="CloseButton_Click"
                        VerticalAlignment="Center"
                        Style="{DynamicResource CadCaptionCloseButtonStyle}"
                        ToolTip="Close">
                    <materialDesign:PackIcon Width="14"
                                             Height="14"
                                             Kind="WindowClose" />
                </Button>
                <TextBlock Margin="16,0,8,0"
                           VerticalAlignment="Center"
                           Style="{DynamicResource CadSectionTitleTextStyle}"
                           Text="Line Graphics"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
        <Border Grid.Row="1"
                Padding="{DynamicResource WindowContentPadding}"
                Background="{DynamicResource SurfaceBrush}">
          <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="ScopeText"
                       Grid.Row="1"
                       Margin="0,4,0,0"
                       Style="{DynamicResource CadCaptionTextStyle}"
                       Text="Selected items"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.Name="Line graphics target scope" />

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Style="{DynamicResource CadBodyTextStyle}"
                           Text="Pattern" />
                <ComboBox x:Name="PatternComboBox"
                          Grid.Column="1"
                          Style="{DynamicResource CadComboBoxStyle}"
                          TabIndex="0"
                          DisplayMemberPath="DisplayText"
                          SelectionChanged="PatternComboBox_SelectionChanged"
                          AutomationProperties.Name="Projection line pattern"
                          AutomationProperties.HelpText="Mixed values remain unchanged. No override uses the DWG or object style." />
            </Grid>

            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Style="{DynamicResource CadBodyTextStyle}"
                           Text="Color" />
                <Button x:Name="ColorButton"
                        Grid.Column="1"
                        Style="{DynamicResource CadButtonStyle}"
                        TabIndex="1"
                        HorizontalContentAlignment="Left"
                        Click="ColorButton_Click"
                        AutomationProperties.Name="Choose projection line color"
                        AutomationProperties.HelpText="Opens the Windows color picker. Mixed values remain unchanged until a color is chosen.">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="ColorPreview"
                                Width="20"
                                Height="20"
                                Margin="0,0,10,0"
                                Background="Transparent"
                                BorderBrush="{DynamicResource SeparatorBrush}"
                                BorderThickness="1"
                                CornerRadius="3" />
                        <TextBlock x:Name="ColorText"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Text="No override — use object style" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Style="{DynamicResource CadBodyTextStyle}"
                           Text="Weight" />
                <ComboBox x:Name="WeightComboBox"
                          Grid.Column="1"
                          Style="{DynamicResource CadComboBoxStyle}"
                          TabIndex="2"
                          DisplayMemberPath="DisplayText"
                          SelectionChanged="WeightComboBox_SelectionChanged"
                          AutomationProperties.Name="Projection line weight"
                          AutomationProperties.HelpText="Mixed values remain unchanged. No override uses the DWG or object style." />
            </Grid>

            <TextBlock x:Name="StateHelpText"
                       Grid.Row="9"
                       Style="{DynamicResource CadCaptionTextStyle}"
                       Text="Mixed values stay unchanged until you choose a value. No override uses the DWG or object style."
                       AutomationProperties.Name="Line graphics state guidance" />

            <Border x:Name="StatusBorder"
                    Grid.Row="11"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <ProgressBar x:Name="ProgressBar"
                                     Height="3"
                                     Margin="0,0,0,7"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed"
                                     AutomationProperties.Name="Line graphics operation in progress" />
                        <TextBlock x:Name="StatusText"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Line graphics status"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <Button x:Name="StatusDismissButton"
                            Grid.Column="2"
                            MinHeight="32"
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Style="{DynamicResource CadButtonStyle}"
                            TabIndex="3"
                            Content="Dismiss"
                            Click="StatusDismissButton_Click"
                            Visibility="Collapsed"
                            AutomationProperties.Name="Dismiss Line Graphics status" />
                </Grid>
            </Border>

            <Border Grid.Row="13"
                    Margin="0,16,0,0"
                    Style="{DynamicResource CadStatusBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{DynamicResource CadBodyTextStyle}"
                                   FontWeight="SemiBold"
                                   Text="Reset this scope" />
                        <TextBlock Margin="0,3,0,0"
                                   Style="{DynamicResource CadCaptionTextStyle}"
                                   Text="Removes pattern, color, and weight overrides. Use Revit Undo to restore them." />
                    </StackPanel>
                    <Button x:Name="ClearButton"
                            Grid.Column="2"
                            MinWidth="132"
                            VerticalAlignment="Center"
                            Style="{DynamicResource CadDangerButtonStyle}"
                            TabIndex="4"
                            AutomationProperties.AccessKey="Alt+C"
                            Content="_Clear All Overrides"
                            Click="ClearButton_Click"
                            AutomationProperties.Name="Clear all line graphics overrides"
                            AutomationProperties.HelpText="Clears line graphics overrides from this scope. The change can be restored with Revit Undo." />
                </Grid>
            </Border>

            <Grid Grid.Row="14" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ApplyButton"
                        Grid.Column="1"
                        MinWidth="112"
                        Style="{DynamicResource CadPrimaryButtonStyle}"
                        TabIndex="5"
                        AutomationProperties.AccessKey="Alt+A"
                        Content="_Apply Changes"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="ApplyButton_Click"
                        AutomationProperties.Name="Apply line graphics" />
                <Button x:Name="CloseButton"
                        Grid.Column="3"
                        MinWidth="84"
                        Style="{DynamicResource CadButtonStyle}"
                        TabIndex="6"
                        AutomationProperties.AccessKey="Alt+L"
                        AutomationProperties.Name="Close Line Graphics"
                        Content="C_lose"
                        IsCancel="True"
                        Click="CloseButton_Click" />
            </Grid>
          </Grid>
        </Border>
    </Grid>
</Window>
