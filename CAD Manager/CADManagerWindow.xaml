<Window
    x:Class="CAD_Manager.CADManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:CAD_Manager"
    xmlns:models="clr-namespace:CAD_Manager.Models"
    xmlns:helpers="clr-namespace:CAD_Manager.Helpers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="CAD Manager"
    Width="464"
    Height="800"
    MinWidth="464"
    MinHeight="500"
    AllowsTransparency="False"
    Background="{DynamicResource SurfaceBrush}"
    KeyboardNavigation.TabNavigation="Cycle"
    KeyDown="Window_KeyDown"
    Loaded="Window_Loaded"
    ResizeMode="CanResize"
    StateChanged="Window_StateChanged"
    WindowStartupLocation="Manual"
    Style="{DynamicResource CadWindowStyle}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      CornerRadius="0"
                      GlassFrameThickness="0,0,0,1"
                      NonClientFrameEdges="None"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!--  Include the StringToVisibilityConverter  -->
        <helpers:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <helpers:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid x:Name="RootGrid"
          Background="{DynamicResource SurfaceBrush}"
          ClipToBounds="True">
        <Border
            Margin="0"
            Background="{DynamicResource SurfaceBrush}"
            CornerRadius="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Sentinel-style drawn caption over native WindowChrome behavior. -->
                <Border Grid.Row="0"
                        Background="{DynamicResource TitleBarMaterialBrush}"
                        BorderBrush="{DynamicResource TitleBarBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <ToggleButton x:Name="PinToggleButton"
                                          Margin="8,2,0,2"
                                          AutomationProperties.Name="Keep CAD Manager on top"
                                          AutomationProperties.HelpText="Keeps this modeless window above Revit while you work."
                                          Click="TogglePin_Click"
                                          VerticalAlignment="Center"
                                          Style="{DynamicResource CadIconToggleButtonStyle}"
                                          TabIndex="0"
                                          ToolTip="Keep CAD Manager on top"
                                          WindowChrome.IsHitTestVisibleInChrome="True">
                                <materialDesign:PackIcon x:Name="PinToggleIcon"
                                                         Width="18"
                                                         Height="18"
                                                         Foreground="{DynamicResource IconBrush}"
                                                         Kind="PinOutline" />
                            </ToggleButton>
                            <Button Margin="4,2,4,2"
                                    AutomationProperties.Name="Open CAD Manager settings"
                                    AutomationProperties.HelpText="Opens theme, selection filter, storage, and shortcut settings."
                                    Click="OpenSettingsButton_Click"
                                    VerticalAlignment="Center"
                                    Style="{DynamicResource CadIconButtonStyle}"
                                    TabIndex="1"
                                    ToolTip="Settings"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                <materialDesign:PackIcon Width="18"
                                                         Height="18"
                                                         Foreground="{DynamicResource IconBrush}"
                                                         Kind="CogOutline" />
                            </Button>
                            <Button AutomationProperties.Name="Minimize CAD Manager"
                                    Click="MinimizeWindow_Click"
                                    Style="{DynamicResource CadCaptionButtonStyle}"
                                    ToolTip="Minimize">
                                <materialDesign:PackIcon Width="14"
                                                         Height="14"
                                                         Kind="WindowMinimize" />
                            </Button>
                            <Button x:Name="MaximizeButton"
                                    AutomationProperties.Name="Maximize CAD Manager"
                                    Click="MaximizeWindow_Click"
                                    Style="{DynamicResource CadCaptionButtonStyle}"
                                    ToolTip="Maximize">
                                <materialDesign:PackIcon x:Name="MaximizeIcon"
                                                         Width="14"
                                                         Height="14"
                                                         Kind="WindowMaximize" />
                            </Button>
                            <Button AutomationProperties.Name="Close CAD Manager"
                                    Click="CloseWindow_Click"
                                    Style="{DynamicResource CadCaptionCloseButtonStyle}"
                                    ToolTip="Close">
                                <materialDesign:PackIcon Width="14"
                                                         Height="14"
                                                         Kind="WindowClose" />
                            </Button>
                        </StackPanel>

                        <StackPanel Margin="16,0,8,0"
                                    VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource CadSectionTitleTextStyle}"
                                       Text="CAD Manager" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!--  Labeled commands make the available actions scannable without relying on icon recall.  -->
                <Border Grid.Row="1"
                        Margin="10,10,10,0"
                        Padding="8,8,2,8"
                        Background="{DynamicResource TitleBarMaterialBrush}"
                        BorderBrush="{DynamicResource SeparatorBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource SurfaceCornerRadius}">
                  <StackPanel>
                    <DockPanel LastChildFill="True">
                        <TextBlock Width="58"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource CadCaptionTextStyle}"
                                   Text="Presets" />
                        <WrapPanel>
                            <Button x:Name="SaveButton"
                                    Margin="0,0,4,0"
                                    Style="{DynamicResource CadButtonStyle}"
                                    TabIndex="3"
                                    AutomationProperties.AccessKey="Alt+S"
                                    AutomationProperties.Name="Save layer visibility settings"
                                    Click="SaveButton_Click"
                                    ToolTip="Save layer visibility settings">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" Foreground="{DynamicResource IconForegroundBrush}" Kind="ContentSaveOutline" />
                                    <AccessText VerticalAlignment="Center" Text="_Save" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="LoadButton"
                                    Margin="0,0,4,0"
                                    Style="{DynamicResource CadButtonStyle}"
                                    TabIndex="4"
                                    AutomationProperties.AccessKey="Alt+L"
                                    AutomationProperties.Name="Load matching template"
                                    Click="LoadButton_Click"
                                    ToolTip="Load matching template">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" Foreground="{DynamicResource IconForegroundBrush}" Kind="DownloadCircleOutline" />
                                    <AccessText VerticalAlignment="Center" Text="_Load" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BrowseButton"
                                    Margin="0,0,4,0"
                                    Style="{DynamicResource CadButtonStyle}"
                                    TabIndex="5"
                                    AutomationProperties.AccessKey="Alt+B"
                                    AutomationProperties.Name="Browse layer templates"
                                    Click="BrowseButton_Click"
                                    ToolTip="Browse layer templates">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" Foreground="{DynamicResource IconForegroundBrush}" Kind="FolderOpenOutline" />
                                    <AccessText VerticalAlignment="Center" Text="_Browse" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ApplyLayerFiltersButton"
                                    Padding="6,0,17,0"
                                    Style="{DynamicResource CadButtonStyle}"
                                    TabIndex="6"
                                    AutomationProperties.AccessKey="Alt+I"
                                    AutomationProperties.Name="Select layers matching filters"
                                    AutomationProperties.HelpText="Replaces the current row selection with visible layers matching the saved rules."
                                    Click="ApplyLayerFiltersButton_Click"
                                    ToolTip="Select matching layers">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16"
                                                             Height="16"
                                                             Margin="0,0,6,0"
                                                             Foreground="{DynamicResource IconForegroundBrush}"
                                                             Kind="FilterCheckOutline" />
                                    <AccessText VerticalAlignment="Center" Text="Apply F_ilters" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0" LastChildFill="True">
                        <TextBlock Width="58"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource CadCaptionTextStyle}"
                                   Text="View" />
                        <WrapPanel>
                            <Button x:Name="ApplyToViewsButton"
                                    Margin="0,0,4,0"
                                    Style="{DynamicResource CadButtonStyle}"
                                    TabIndex="7"
                                    AutomationProperties.AccessKey="Alt+V"
                                    AutomationProperties.Name="Apply current settings to views"
                                    Click="ApplyToViewsButton_Click"
                                    ToolTip="Apply current settings to views">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" Foreground="{DynamicResource IconForegroundBrush}" Kind="ApplicationExport" />
                                    <AccessText VerticalAlignment="Center" Text="Apply to _Views" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RefreshButton"
                                    Style="{DynamicResource CadButtonStyle}"
                                    TabIndex="8"
                                    AutomationProperties.AccessKey="Alt+R"
                                    AutomationProperties.Name="Refresh active view"
                                    Click="RefreshButton_Click"
                                    ToolTip="Refresh active view">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" Foreground="{DynamicResource IconForegroundBrush}" Kind="Refresh" />
                                    <AccessText VerticalAlignment="Center" Text="_Refresh" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </DockPanel>
                  </StackPanel>
                </Border>

                <!--  Search sits directly above the content it filters.  -->
                <Grid
                    Grid.Row="2"
                    Margin="10,8,10,0">
                    <Border
                        Height="32"
                        Background="{DynamicResource ControlSurfaceBrush}"
                        BorderBrush="{DynamicResource SeparatorBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="SearchBox"
                                         TabIndex="9"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         FocusVisualStyle="{DynamicResource CadKeyboardFocusVisualStyle}"
                                         AutomationProperties.Name="Search DWGs and layers"
                                         AutomationProperties.AccessKey="Alt+F"
                                         AutomationProperties.HelpText="Type to filter the tree. Press Alt+F to focus search."
                                         Background="Transparent"
                                         BorderThickness="0"
                                         CaretBrush="{DynamicResource ForegroundBrush}"
                                         Foreground="{DynamicResource ForegroundBrush}"
                                         SelectionBrush="{DynamicResource TextHighlightBrush}"
                                         TextChanged="SearchBox_TextChanged" />
                                <TextBlock Margin="10,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Style="{DynamicResource CadCaptionTextStyle}"
                                           Text="Search DWGs and layers"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Text, Converter={StaticResource StringToVisibilityConverter}, ElementName=SearchBox}" />
                            </Grid>
                            <Button Grid.Column="1"
                                    Width="32"
                                    Height="32"
                                    Style="{DynamicResource CadIconButtonStyle}"
                                    TabIndex="10"
                                    AutomationProperties.Name="Clear search"
                                    AutomationProperties.HelpText="Clears the current DWG and layer filter."
                                    Click="ClearButton_Click"
                                    ToolTip="Clear search">
                                <materialDesign:PackIcon Width="16"
                                                         Height="16"
                                                         Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                         Kind="CloseCircleOutline" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
                <Border
                    x:Name="StatusBorder"
                    Grid.Row="4"
                    Margin="10,2,10,4"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Visibility="Visible">
                    <Grid MinHeight="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon x:Name="StatusIcon"
                                                 Width="16"
                                                 Height="16"
                                                 VerticalAlignment="Center"
                                                 AutomationProperties.Name="Error"
                                                 Foreground="{DynamicResource ErrorBrush}"
                                                 IsHitTestVisible="False"
                                                 Kind="AlertCircleOutline"
                                                 Visibility="Collapsed" />
                        <TextBlock x:Name="StatusText"
                                   Grid.Column="2"
                                   VerticalAlignment="Center"
                                   AutomationProperties.Name="CAD Manager status and current context"
                                   AutomationProperties.LiveSetting="Polite"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Style="{DynamicResource CadCaptionTextStyle}"
                                   Text="Active view  ·  No selection"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                        <Button x:Name="StatusDismissButton"
                                Grid.Column="4"
                                Width="20"
                                Height="20"
                                MinWidth="20"
                                MinHeight="20"
                                Padding="3"
                                Style="{DynamicResource CadIconButtonStyle}"
                                    TabIndex="12"
                                AutomationProperties.Name="Dismiss error"
                                AutomationProperties.HelpText="Dismisses the current error and restores the active view and selection summary."
                                Click="StatusDismissButton_Click"
                                ToolTip="Dismiss error"
                                Visibility="Collapsed">
                            <materialDesign:PackIcon Width="14"
                                                     Height="14"
                                                     Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                     Kind="Close" />
                        </Button>
                    </Grid>
                </Border>
                <Border
                    Grid.Row="3"
                    Margin="10,10,10,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource ElevatedSurfaceBrush}"
                    BorderBrush="{DynamicResource SeparatorBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource SurfaceCornerRadius}">
                    <!--  TreeView  -->
                    <TreeView
                        x:Name="DWGTreeView"
                        Grid.Row="2"
                        Grid.ColumnSpan="3"
                        Margin="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Focusable="True"
                        TabIndex="13"
                        AutomationProperties.Name="DWGs and layers"
                        AutomationProperties.HelpText="Use arrows to navigate, Space to toggle visibility, and Ctrl or Shift for multi-selection."
                        Foreground="{DynamicResource IconBrush}"
                        HorizontalContentAlignment="Stretch"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ItemsSource="{Binding FilteredDWGNodes}"
                        PreviewMouseLeftButtonDown="TreeView_PreviewMouseLeftButtonDown">

                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="MinHeight" Value="24" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{DynamicResource CadKeyboardFocusVisualStyle}" />
                                <EventSetter Event="Loaded" Handler="TreeViewItem_Loaded" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="TreeVisibilityToggleStyle" TargetType="CheckBox">
                                <Setter Property="Width" Value="24" />
                                <Setter Property="Height" Value="24" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="FocusVisualStyle" Value="{DynamicResource CadKeyboardFocusVisualStyle}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="CheckBox">
                                            <Border x:Name="ToggleBorder"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                                <materialDesign:PackIcon x:Name="VisibilityIcon"
                                                                         Width="18"
                                                                         Height="18"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource IconBrush}"
                                                                         Kind="EyeOffOutline" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="VisibilityIcon" Property="Kind" Value="EyeOutline" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.55" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style x:Key="TreeHalftoneToggleStyle" TargetType="ToggleButton">
                                <Setter Property="Width" Value="24" />
                                <Setter Property="Height" Value="24" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="FocusVisualStyle" Value="{DynamicResource CadKeyboardFocusVisualStyle}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ToggleBorder"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                                <materialDesign:PackIcon x:Name="HalftoneIcon"
                                                                         Width="18"
                                                                         Height="18"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource IconBrush}"
                                                                         Kind="CircleOutline"
                                                                         Opacity="0.65" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="HalftoneIcon" Property="Kind" Value="CircleHalfFull" />
                                                    <Setter TargetName="HalftoneIcon" Property="Opacity" Value="1" />
                                                    <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                                    <Setter TargetName="HalftoneIcon" Property="Opacity" Value="1" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.55" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style x:Key="TreeGraphicsButtonStyle"
                                   BasedOn="{StaticResource CadIconButtonStyle}"
                                   TargetType="Button">
                                <Setter Property="Width" Value="24" />
                                <Setter Property="Height" Value="24" />
                                <Setter Property="MinWidth" Value="24" />
                                <Setter Property="MinHeight" Value="24" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="ToolTip" Value="Edit line graphics" />
                            </Style>

                            <HierarchicalDataTemplate DataType="{x:Type models:DWGNode}" ItemsSource="{Binding Layers}">
                                <Border Padding="0" Background="Transparent">
                                    <Grid MinHeight="24">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.HelpText="Changes all selected rows when this row is selected."
                                                  AutomationProperties.Name="{Binding Name, StringFormat=Toggle visibility for {0}}"
                                                  Click="CheckBox_Toggled"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  IsThreeState="False"
                                                  ToolTip="Toggle visibility">
                                            <CheckBox.Style>
                                                <Style BasedOn="{StaticResource TreeVisibilityToggleStyle}" TargetType="CheckBox">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsVisibilityPending}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                        <TextBlock Grid.Column="1"
                                                   Margin="4,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}"
                                                   ToolTipOpening="NameText_ToolTipOpening" />
                                        <ToggleButton Grid.Column="2"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.HelpText="Changes all selected DWGs when this row is selected."
                                                      AutomationProperties.Name="{Binding Name, StringFormat=Toggle halftone for {0}}"
                                                      Click="Halftone_Toggled"
                                                      IsChecked="{Binding IsHalftone, Mode=TwoWay}"
                                                      ToolTip="Toggle halftone">
                                            <ToggleButton.Style>
                                                <Style BasedOn="{StaticResource TreeHalftoneToggleStyle}" TargetType="ToggleButton">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHalftonePending}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                        <Button Grid.Column="3"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource TreeGraphicsButtonStyle}"
                                                AutomationProperties.Name="{Binding Name, StringFormat=Edit line graphics for {0}}"
                                                Click="TreeViewItem_EditButton_Click"
                                                Tag="{Binding}">
                                            <materialDesign:PackIcon Width="18" Height="18" Foreground="{DynamicResource IconBrush}" Kind="Palette" Opacity="0.75" />
                                        </Button>
                                        <TextBlock Grid.Column="4"
                                                   Margin="6,0,2,0"
                                                   VerticalAlignment="Center"
                                                   Style="{DynamicResource CadRowStatusTextStyle}"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   Text="Pending"
                                                   Visibility="{Binding IsVisibilityPending, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   Grid.ColumnSpan="4"
                                                   Margin="4,2,4,2"
                                                   AutomationProperties.LiveSetting="Assertive"
                                                   Foreground="{DynamicResource ErrorBrush}"
                                                   Text="{Binding OperationError}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding OperationError, Converter={StaticResource NonEmptyStringToVisibilityConverter}}" />
                                    </Grid>
                                </Border>
                            </HierarchicalDataTemplate>

                            <DataTemplate DataType="{x:Type models:LayerNode}">
                                <Border Padding="0" Background="Transparent">
                                    <Grid MinHeight="24">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.HelpText="Changes all selected rows when this row is selected."
                                                  AutomationProperties.Name="{Binding Name, StringFormat=Toggle visibility for {0}}"
                                                  Click="CheckBox_Toggled"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  IsThreeState="False"
                                                  ToolTip="Toggle visibility">
                                            <CheckBox.Style>
                                                <Style BasedOn="{StaticResource TreeVisibilityToggleStyle}" TargetType="CheckBox">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsVisibilityPending}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                        <TextBlock Grid.Column="1"
                                                   Margin="4,0,8,0"
                                                   VerticalAlignment="Center"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}"
                                                   ToolTipOpening="NameText_ToolTipOpening" />
                                        <Button Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource TreeGraphicsButtonStyle}"
                                                AutomationProperties.Name="{Binding Name, StringFormat=Edit line graphics for {0}}"
                                                Click="TreeViewItem_EditButton_Click"
                                                Tag="{Binding}">
                                            <materialDesign:PackIcon Width="18" Height="18" Foreground="{DynamicResource IconBrush}" Kind="Palette" Opacity="0.75" />
                                        </Button>
                                        <TextBlock Grid.Column="3"
                                                   Margin="6,0,2,0"
                                                   VerticalAlignment="Center"
                                                   Style="{DynamicResource CadRowStatusTextStyle}"
                                                   Text="Pending"
                                                   Visibility="{Binding IsVisibilityPending, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   Grid.ColumnSpan="3"
                                                   Margin="4,2,4,2"
                                                   AutomationProperties.LiveSetting="Assertive"
                                                   Foreground="{DynamicResource ErrorBrush}"
                                                   Text="{Binding OperationError}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding OperationError, Converter={StaticResource NonEmptyStringToVisibilityConverter}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>

                </Border>
